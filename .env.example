# Copy this file to .env and fill in real values.
# For local development these come from supabase/.env (generated by
# supabase/utils/generate-keys.sh) — see README.md for setup steps.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser or commit a real value
SUPABASE_SERVICE_ROLE_KEY=

# Optional — AI-assisted drafting (NPC descriptions, lore pages).
# This is the ONE piece of the app that isn't self-hosted: it calls the
# external Anthropic API. Leave it unset and the app works fully — the
# "Generate a draft" actions simply hide themselves with an explanation.
# Server-only; never exposed to the browser.
ANTHROPIC_API_KEY=
